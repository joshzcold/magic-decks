  "cut_reasons": {
    "Commander's Sphere": "Replaced by Death to Our Enemies — creates Treasures every noncreature spell and converts to 3x 3/3 tokens",
    "Conduct Electricity": "Replaced by Repulsor Blast — with Scarlet Witch discount costs 2, teamwork turns it into 5 damage to each creature",
    "Renegade Bull": "Replaced by Hawkeye, Young Avenger — amplifies all noncombat damage sources (Dragon Tempest, Psychosis Crawler, Spit Flame)",
    "Crackling Cyclops": "Replaced by Superior Foes of Spider-Man — same CMC but gives actual card advantage on each CMC 4+ spell cast",
    "Twin Blades": "Replaced by Team Tactics — same double strike but also deals 3 to each opponent when Teamwork 1 is met",
    "Runehorn Hellkite": "Replaced by Flashback — symmetrical wheel refills opponents' hands too; Flashback rebuys our own best graveyard spell and gets discounted a second time by Scarlet Witch's power",
    "Coveted Jewel": "Replaced by Zealous Lorecaster — opponents can steal it by attacking unblocked; Zealous Lorecaster returns an instant/sorcery to hand for a second discounted cast",
    "Hidetsugu's Second Rite": "Replaced by Mica, Reader of Ruins — only relevant if a player is at exactly 10 life; Mica copies our discounted instant/sorcery spells by saccing an artifact",
    "Broadcast Takeover": "Replaced by Prismari Pianist — only relevant if opponents control artifacts; Prismari Pianist makes 3 tokens instead of 1 when the spell cast is MV5+, directly rewarding the big spells Scarlet Witch discounts"
  },
